# qatee
منصة قطيع لإدارة الدواجن البيضاء

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="قَطِيع منصة عربية لإدارة وتحليل دورات تسمين الدواجن البيضاء.">
  <title>قَطِيع | إدارة أذكى وإنتاج أفضل</title>

  <style>
    :root {
      --green: #153F35;
      --light-green: #D7E9A7;
      --gold: #E6A85B;
      --background: #F4F6F1;
      --white: #FFFFFF;
      --text: #26352F;
      --muted: #718078;
      --border: #E2E9E1;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Tahoma, Arial, sans-serif;
      background: var(--background);
      color: var(--text);
      line-height: 1.8;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .container {
      width: min(1100px, 92%);
      margin: auto;
    }

    header {
      background: var(--white);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .navbar {
      min-height: 75px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .logo {
      color: var(--green);
      font-size: 27px;
      font-weight: bold;
    }

    .logo span {
      color: var(--gold);
    }

    nav {
      display: flex;
      gap: 22px;
      align-items: center;
      font-size: 14px;
    }

    nav a:hover {
      color: #9B6B2F;
    }

    .hero {
      padding: 75px 0;
      background: var(--green);
      color: var(--white);
      overflow: hidden;
    }

    .hero-content {
      max-width: 720px;
    }

    .hero-label {
      display: inline-block;
      color: var(--light-green);
      border: 1px solid #557568;
      border-radius: 30px;
      padding: 5px 15px;
      font-size: 13px;
      margin-bottom: 20px;
    }

    .hero h1 {
      font-size: clamp(30px, 6vw, 48px);
      line-height: 1.5;
      margin-bottom: 15px;
    }

    .hero h1 span {
      color: var(--light-green);
    }

    .hero p {
      color: #DCE8E1;
      font-size: 17px;
      margin-bottom: 28px;
      max-width: 600px;
    }

    .main-button {
      display: inline-block;
      background: var(--gold);
      color: #26352F;
      padding: 12px 25px;
      border-radius: 9px;
      font-weight: bold;
      transition: 0.2s;
    }

    .main-button:hover {
      background: #F0BC7D;
      transform: translateY(-2px);
    }

    section {
      padding: 65px 0;
    }

    .section-heading {
      margin-bottom: 30px;
    }

    .section-heading h2 {
      color: var(--green);
      font-size: 27px;
      margin-bottom: 8px;
    }

    .section-heading p {
      color: var(--muted);
      font-size: 15px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
    }

    .card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 23px;
      transition: 0.2s;
    }

    .card:hover {
      transform: translateY(-4px);
      border-color: var(--gold);
    }

    .card-icon {
      font-size: 30px;
      margin-bottom: 12px;
    }

    .card h3 {
      color: var(--green);
      font-size: 18px;
      margin-bottom: 8px;
    }

    .card p {
      color: var(--muted);
      font-size: 14px;
    }

    .soon {
      display: inline-block;
      margin-top: 15px;
      background: #F4F0E7;
      color: #91662E;
      padding: 3px 11px;
      border-radius: 20px;
      font-size: 12px;
    }

    .calculator-section {
      background: #EAF0E8;
    }

    .calculator {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 25px;
      max-width: 650px;
    }

    .calculator h3 {
      color: var(--green);
      margin-bottom: 15px;
    }

    .field {
      margin-bottom: 15px;
    }

    .field label {
      display: block;
      font-size: 14px;
      margin-bottom: 6px;
      font-weight: bold;
    }

    .field input {
      width: 100%;
      padding: 12px;
      border: 1px solid #D5DED6;
      border-radius: 8px;
      font-size: 16px;
      font-family: inherit;
      outline: none;
    }

    .field input:focus {
      border-color: var(--green);
    }

    .calculate-button {
      border: 0;
      background: var(--green);
      color: var(--white);
      padding: 12px 22px;
      border-radius: 8px;
      font-family: inherit;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
    }

    .calculate-button:hover {
      background: #245B4B;
    }

    .result {
      display: none;
      margin-top: 18px;
      padding: 15px;
      border-radius: 9px;
      background: #EDF4E6;
      color: var(--green);
      font-weight: bold;
    }

    .result.error {
      background: #FCECEC;
      color: #A52C2C;
    }

    .info-note {
      margin-top: 12px;
      color: var(--muted);
      font-size: 12px;
    }

    .about-box {
      background: var(--green);
      color: var(--white);
      padding: 35px;
      border-radius: 16px;
    }

    .about-box h2 {
      color: var(--light-green);
      margin-bottom: 12px;
    }

    .about-box p {
      color: #DCE8E1;
    }

    footer {
      background: #102F28;
      color: #DCE8E1;
      padding: 28px 0;
      text-align: center;
      font-size: 13px;
    }

    footer strong {
      color: var(--light-green);
    }

    @media (max-width: 650px) {
      .navbar {
        flex-direction: column;
        padding: 12px 0;
      }

      nav {
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
        font-size: 12px;
      }

      .hero {
        padding: 55px 0;
      }

      section {
        padding: 48px 0;
      }

      .about-box {
        padding: 24px;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="container navbar">
      <a href="#" class="logo">قَطِيع<span>.</span></a>

      <nav>
        <a href="#home">الرئيسية</a>
        <a href="#calculators">الحاسبات</a>
        <a href="#farm">إدارة المزارع</a>
        <a href="#library">المكتبة العلمية</a>
      </nav>
    </div>
  </header>

  <main>

    <section class="hero" id="home">
      <div class="container">
        <div class="hero-content">
          <span class="hero-label">منصة متخصصة في الدواجن البيضاء</span>

          <h1>
            كل ما تحتاجه لإدارة
            <span>دورة التسمين</span>
            في مكان واحد
          </h1>

          <p>
            قَطِيع تساعدك على متابعة أداء الدورات،
            وتحليل استهلاك العلف والأوزان والنافق،
            واتخاذ قرارات مبنية على الأرقام.
          </p>

          <a href="#calculators" class="main-button">
            استكشف الحاسبات
          </a>
        </div>
      </div>
    </section>

    <section id="calculators">
      <div class="container">
        <div class="section-heading">
          <h2>حاسبات دورة التسمين</h2>
          <p>أدوات حسابية لمتابعة أهم مؤشرات دورة الدواجن البيضاء.</p>
        </div>

        <div class="cards">

          <div class="card">
            <div class="card-icon">⚖️</div>
            <h3>متوسط الأوزان</h3>
            <p>حساب متوسط وزن العينة ومتابعة تطور أوزان الطيور.</p>
            <span class="soon">قريبًا</span>
          </div>

          <div class="card">
            <div class="card-icon">🌾</div>
            <h3>استهلاك العلف</h3>
            <p>حساب العلف الوارد والمستهلك والمرتجع.</p>
            <span class="soon">قريبًا</span>
          </div>

          <div class="card">
            <div class="card-icon">📊</div>
            <h3>معامل التحويل</h3>
            <p>متابعة معامل التحويل الغذائي للدورة.</p>
            <span class="soon">قريبًا</span>
          </div>

          <div class="card">
            <div class="card-icon">🐔</div>
            <h3>نسبة النافق</h3>
            <p>احسب نسبة النافق من العدد الابتدائي للطيور.</p>
            <a href="#mortality" class="soon">افتح الحاسبة</a>
          </div>

          <div class="card">
            <div class="card-icon">💰</div>
            <h3>تكلفة الدورة</h3>
            <p>متابعة التكاليف والإيرادات وحساب نتائج الدورة.</p>
            <span class="soon">قريبًا</span>
          </div>

          <div class="card">
            <div class="card-icon">🏭</div>
            <h3>احتياجات العلف</h3>
            <p>تقدير احتياجات البادي والنامي والناهي.</p>
            <span class="soon">قريبًا</span>
          </div>

        </div>
      </div>
    </section>

    <section class="calculator-section" id="mortality">
      <div class="container">
        <div class="section-heading">
          <h2>حاسبة نسبة النافق</h2>
          <p>احسب نسبة النافق بسهولة خلال ثوانٍ.</p>
        </div>

        <div class="calculator">
          <h3>بيانات الدورة</h3>

          <div class="field">
            <label for="initial">العدد الابتدائي للكتاكيت</label>
            <input type="number" id="initial" min="1" placeholder="مثال: 10000">
          </div>

          <div class="field">
            <label for="dead">إجمالي عدد النافق</label>
            <input type="number" id="dead" min="0" placeholder="مثال: 250">
          </div>

          <button class="calculate-button" onclick="calculateMortality()">
            احسب النسبة
          </button>

          <div class="result" id="result"></div>

          <p class="info-note">
            المعادلة: نسبة النافق = (إجمالي النافق ÷ العدد الابتدائي) × 100.
          </p>
        </div>
      </div>
    </section>

    <section id="farm">
      <div class="container">
        <div class="section-heading">
          <h2>إدارة المزارع والعنابر</h2>
          <p>منظومة واحدة لمتابعة أكثر من مزرعة وعنبر ودورة إنتاجية.</p>
        </div>

        <div class="cards">
          <div class="card">
            <div class="card-icon">🏡</div>
            <h3>إدارة المزارع</h3>
            <p>تنظيم بيانات المزارع والدورات الإنتاجية.</p>
            <span class="soon">قريبًا</span>
          </div>

          <div class="card">
            <div class="card-icon">🏠</div>
            <h3>متابعة العنابر</h3>
            <p>متابعة كل عنبر ومقارنة أدائه بالعنابر الأخرى.</p>
            <span class="soon">قريبًا</span>
          </div>

          <div class="card">
            <div class="card-icon">📈</div>
            <h3>التقارير والتحليل</h3>
            <p>رسوم بيانية وتقارير توضح نتائج الدورة.</p>
            <span class="soon">قريبًا</span>
          </div>
        </div>
      </div>
    </section>

    <section id="library">
      <div class="container">
        <div class="about-box">
          <h2>المكتبة العلمية</h2>
          <p>
            مكتبة متخصصة في تربية الدواجن البيضاء،
            تضم معلومات ومراجع تعليمية عن التغذية
            والإدارة والتحصين والصحة والأداء الإنتاجي.
            سيتم تنظيم المحتوى ومراجعته قبل نشره.
          </p>
          <span class="soon">قريبًا</span>
        </div>
      </div>
    </section>

  </main>

  <footer>
    <div class="container">
      <strong>قَطِيع | QATEE</strong>
      <p>إدارة أذكى... وإنتاج أفضل</p>
      <p>© 2026 قطيع - جميع الحقوق محفوظة</p>
    </div>
  </footer>

  <script>
    function calculateMortality() {
      const initial = Number(document.getElementById("initial").value);
      const dead = Number(document.getElementById("dead").value);
      const result = document.getElementById("result");

      result.style.display = "block";
      result.classList.remove("error");

      if (
        !Number.isInteger(initial) ||
        !Number.isInteger(dead) ||
        initial <= 0 ||
        dead < 0 ||
        dead > initial
      ) {
        result.classList.add("error");
        result.textContent =
          "يرجى إدخال أعداد صحيحة، والتأكد أن النافق لا يتجاوز العدد الابتدائي.";
        return;
      }

      const percentage = (dead / initial) * 100;
      const remaining = initial - dead;

      result.innerHTML =
        "نسبة النافق: " + percentage.toFixed(2) + "%<br>" +
        "العدد المتبقي: " + remaining.toLocaleString("en-US") + " طائر";
    }
  </script>

</body>
</html>
